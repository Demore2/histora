[{"tekst":"Alexander the Great never lost a major battle.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\00.wav"},{"tekst":"The only army that stopped him was his own.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\01.wav"},{"tekst":"At twenty, he became king of Macedon,","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\02.wav"},{"tekst":"after his father was murdered at a wedding.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\03.wav"},{"tekst":"He crossed into Asia.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\04.wav"},{"tekst":"Twice, the Persian king fled from him.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\05.wav"},{"tekst":"The largest empire on earth collapsed.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\06.wav"},{"tekst":"He marched on, to India.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\07.wav"},{"tekst":"Then, at the river Hyphasis, his own soldiers refused to go on.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\08.wav"},{"tekst":"He turned back.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\09.wav"},{"tekst":"Three years later, he was dead.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\10.wav"},{"tekst":"He was thirty-two.","uit":"G:\\History App\\marketing\\remotion\\voice\\alexander-the-great\\placeholder\\11.wav"},{"tekst":"The full story is in Histora. Link in bio.","uit":"G:\\History App\\marketing\\remotion\\voice\\shared\\cta-placeholder.wav"}]